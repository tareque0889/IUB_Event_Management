# Loaded by `vite --mode test` (see playwright.config.ts). Blanking the Firebase
# variables forces demo mode (local seeded data, no network), so E2E tests never
# read from or write to the production Firestore project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
